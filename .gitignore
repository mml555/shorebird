# cspell:words serverinfo sshkey pycache selftest
# See https://www.dartlang.org/guides/libraries/private-files
# Files and directories created by pub
.dart_tool/
.packages
build/

# Test related files
# Coverage directories used by Flutter & Dart tests.
# Anchored to package roots: an unanchored `coverage/` also matched
# selfhost/engine/route_b/coverage/, which is SOURCE — the cell-shipped
# analyzer, its parity harness and the pinned corpus — and silently kept all of
# it out of the repository.
logs/
/coverage/
packages/*/coverage/
coverage_badge.svg

# Cached files
bin/cache/

# Misc
.DS_Store
.claude/
serverinfo.md
sshkey20.120.104.70.pem

# Locally built experimental engine artifacts served by the CDN mirror
# (selfhost/engine/overlay_publish.sh). Hundreds of MB of build output.
selfhost/cdn/overlay/*
!selfhost/cdn/overlay/.gitkeep

# Local git mirrors for air-gapped installs (selfhost/cdn/README.md). Gigabytes.
selfhost/cdn/mirrors/

# Air-gap acceptance fixture: generated, reproducible from the committed
# sources by selfhost/scripts/prepare_airgap_fixture.sh.
selfhost/fixtures/airgap_app/ios/
selfhost/fixtures/airgap_app/android/
selfhost/fixtures/airgap_app/.dart_tool/
selfhost/fixtures/airgap_app/build/
selfhost/fixtures/airgap/

# Instance-specific (server-generated app_id) and flutter-create output.
selfhost/fixtures/airgap_app/shorebird.yaml
selfhost/fixtures/airgap_app/.metadata
selfhost/fixtures/airgap_app/.gitignore
selfhost/fixtures/airgap_app/.generated/
selfhost/fixtures/airgap/acceptance.env

# Local run logs (acceptance/warm runs).
.logs/
selfhost/fixtures/airgap/endpoint.stamp

# Python bytecode from the compatibility-study harness
__pycache__/

# cspell_touched.sh --self-test scratch (created and removed in one run)
/.cspell-selftest/

# Vendored Flutter checkout — untracked 2026-08-18.
# Durability is covered three other ways; see selfhost/BASELINE.md:
#   selfhost/cdn/mirrors/flutter.git   (bare, bootstrap-from-mirror verified)
#   mml555/shorebird-flutter-mirror    (offsite, restore-tested)
#   mml555/shorebird-flutter           (our fork, carries route-b)
# Build scripts take --root; see selfhost/engine/build.sh.
vendor/flutter/

# The P1 device specimen's build output and resolved deps, same as every other
