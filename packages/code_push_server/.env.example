# ---------------------------------------------------------------------------
# code_push_server — production environment file
#
# Copy to `.env` and fill in real values BEFORE running docker-compose.prod.yaml:
#
#     cp .env.example .env
#
# `.env` is git-ignored — never commit it. Every value marked "CHANGE ME"
# MUST be replaced before exposing the server to the internet.
#
# Generate strong secrets with:
#
#     openssl rand -hex 32
#
# ---------------------------------------------------------------------------


# === Reverse proxy / TLS (Caddy) ===========================================

# The public domain Caddy serves and obtains a TLS cert for (Let's Encrypt).
# For purely local testing you can leave this as localhost and use the
# `tls internal` block in the Caddyfile (see comments there).
DOMAIN=code-push.example.com

# Email passed to the ACME CA for expiry notices (optional but recommended).
ACME_EMAIL=ops@example.com


# === Server (consumed by lib/src/config.dart) ==============================

# Turns on production mode. When true, the server REFUSES TO BOOT if any secret
# below is still a dev default (JWT_SECRET, URL_SIGNING_SECRET, API_KEY, the DB
# password, S3_SECRET_KEY) or if PUBLIC_BASE_URL is non-HTTPS. Keep this `true`
# for any internet-facing deploy — it is your guardrail against shipping the
# dev defaults. (Leave unset/false only for local, non-exposed testing.)
PRODUCTION=true

# Port the Dart server listens on INSIDE its container. Caddy proxies to it;
# you normally do not publish this port to the host in production.
PORT=8080

# Absolute, publicly reachable base URL embedded in artifact upload/download
# URLs and used as the default JWT issuer. Must match how devices reach the
# server (i.e. your Caddy domain over HTTPS).
PUBLIC_BASE_URL=https://code-push.example.com

# Postgres connection string. Host = the compose service name `postgres`,
# port 5432 (in-network). The user/password/db here MUST match the
# POSTGRES_* values below.
# CHANGE ME — pick a strong DB password.
DATABASE_URL=postgres://cps:CHANGE_ME_db_password@postgres:5432/code_push

# S3 / MinIO endpoint. Host = the compose service name `minio`, port 9000.
# Use http:// for the in-network MinIO; only use https:// if MinIO itself
# terminates TLS.
S3_ENDPOINT=http://minio:9000
# CHANGE ME — must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below.
S3_ACCESS_KEY=cps
S3_SECRET_KEY=CHANGE_ME_minio_secret
S3_BUCKET=code-push-artifacts

# Bootstrap API key accepted in addition to any per-user keys in the DB.
# Handy for first boot; ROTATE / remove once real users are seeded.
# CHANGE ME — openssl rand -hex 32
API_KEY=sb_api_CHANGE_ME

# JWT issuer (`iss` claim). Must equal the CLI's SHOREBIRD_JWT_ISSUER and the
# jwt_issuer returned by /users/me. Defaults to PUBLIC_BASE_URL if unset;
# set it explicitly to keep it stable across URL changes.
SHOREBIRD_JWT_ISSUER=https://code-push.example.com

# HMAC secret for minting session JWTs (OAuth login).
# CHANGE ME — openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret

# HMAC secret for short-lived signed download URLs.
# CHANGE ME — openssl rand -hex 32
URL_SIGNING_SECRET=CHANGE_ME_url_signing_secret

# TTL (seconds) for signed download URLs.
DOWNLOAD_URL_TTL=300

# Max artifact upload size in bytes; larger uploads are rejected with 413.
# Default 512 MiB. Enforced server-side (in addition to any reverse-proxy cap).
MAX_UPLOAD_BYTES=536870912

# Per-client request rate limit (requests per minute). Authenticated requests
# are bucketed by API key/JWT; unauthenticated device requests by client IP
# (X-Forwarded-For behind a proxy) — so one device can't throttle the fleet.
RATE_LIMIT_PER_MINUTE=600

# Rate-limit counter backend: `memory` (in-process fixed window; per-instance,
# resets on restart — fine for a single node) or `postgres` (shared window,
# correct across restarts and multiple server replicas). Use `postgres` when
# running more than one server instance behind Caddy.
RATE_LIMIT_BACKEND=memory

# Artifact upload method advertised to the CLI on register: `multipart` (single
# POST) or `resumable` (GCS-style chunked PUT with Content-Range/308). Leave as
# `multipart` unless you specifically need resumable uploads.
UPLOAD_METHOD=multipart

# Email allowed to complete OAuth login when NO external IdP is configured
# (single-tenant self-consent / bootstrap login). Ignored once the IDP_* broker
# below is enabled — then identity comes from the IdP's email claim.
LOGIN_EMAIL=you@example.com


# === External OAuth IdP broker (optional) ==================================
# Set these to broker `shorebird login` against a real IdP (Google, Microsoft/
# Entra, Okta, …). Broker mode turns on only when IDP_CLIENT_ID + the two URLs
# are all set; otherwise /login self-consents LOGIN_EMAIL above.
#
# Register this EXACT redirect URI at the IdP: <PUBLIC_BASE_URL>/oauth/callback
# See selfhost/IDP_SETUP.md for Google + Microsoft/Entra walkthroughs.
#
# Google:    IDP_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
#            IDP_TOKEN_URL=https://oauth2.googleapis.com/token
# Entra:     IDP_AUTHORIZE_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize
#            IDP_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
#
# Leave IDP_CLIENT_ID empty to keep broker mode OFF.
IDP_CLIENT_ID=
# CHANGE ME — the OAuth client secret from your IdP (required in broker mode).
IDP_CLIENT_SECRET=
IDP_AUTHORIZE_URL=
IDP_TOKEN_URL=
# Space-separated scopes; MUST include a scope that yields the `email` claim.
# Quoted so tools that `source` this file (ops/backup.sh, ops/restore.sh) don't
# split on the space.
IDP_SCOPES="openid email"


# === Postgres service (docker-compose.prod.yaml) ===========================
# These MUST stay consistent with DATABASE_URL above.
POSTGRES_USER=cps
# CHANGE ME — same value as the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=code_push


# === MinIO service (docker-compose.prod.yaml) ==============================
# These MUST stay consistent with S3_ACCESS_KEY / S3_SECRET_KEY above.
MINIO_ROOT_USER=cps
# CHANGE ME — same value as S3_SECRET_KEY.
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret


# === Backups (ops/backup.sh, ops/restore.sh) ===============================
# Directory on the host where backups are written / read.
BACKUP_DIR=./backups
