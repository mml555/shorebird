# The proxy address 10.0.2.2 is the slirp4netns host-loopback alias, which containers use to
# reach the host; gha-egress-apply also puts it on the host's lo so jobs on the host and in
# containers (job env is passed into container actions) share one address.
# Proxy environment of the gha-* runner users. KEY=VALUE lines: read by gha-prep
# (appended to the runner's .env, so every job sees it) and sourced by gha-run
# (so the runner listener and each rootless dockerd get it too).
https_proxy=http://10.0.2.2:3128
http_proxy=http://10.0.2.2:3128
HTTPS_PROXY=http://10.0.2.2:3128
HTTP_PROXY=http://10.0.2.2:3128
no_proxy=localhost,127.0.0.1,::1,10.0.2.2
NO_PROXY=localhost,127.0.0.1,::1,10.0.2.2
