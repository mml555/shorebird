[Unit]
Description=Outbound allowlist for the GitHub Actions runner users (nftables table gha_egress)
Documentation=file:///usr/local/sbin/gha-egress-apply
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target
Before=squid.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gha-egress-apply
ExecReload=/usr/local/sbin/gha-egress-apply
# No ExecStop: stopping or restarting this unit must not remove the table, or running jobs
# would have unrestricted egress. The table stays loaded; gha-egress-apply replaces it.

[Install]
WantedBy=multi-user.target
