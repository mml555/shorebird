   if (sid == kInvalidSelectorId) return nullptr;
   const TableSelector* selector = &selectors_[sid];
+  // SELFHOST: upstream. The IsUsed() test was removed here for a while, to
+  // survive a table-selector metadata table full of zeroed call counts. That
+  // was a symptom of feeding Shorebird's forked frontend_server's dill to this
+  // vanilla backend; with a frontend from this same tree the counts are real
+  // and the test is correct. Never remove it again without also checking
+  // `bin/cache/dart-sdk/revision` — see selfhost/TFA_ROOT_CAUSE.md.
   if (!selector->IsUsed()) return nullptr;
   if (selector->offset == kInvalidSelectorOffset) return nullptr;
   return selector;
