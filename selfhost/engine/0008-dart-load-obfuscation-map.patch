+void Obfuscator::ObfuscationState::SetCursor(const char* cursor) {
+  const intptr_t len = strlen(cursor);
+  RELEASE_ASSERT(len < static_cast<intptr_t>(sizeof(name_)));
+  memset(name_, 0, sizeof(name_));
+  memmove(name_, cursor, len);
+}
