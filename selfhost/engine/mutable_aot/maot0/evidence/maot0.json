    "out_of_scope_rows": [],
    "boundaries": [
      {
        "id": "NB-1",
        "title": "Native platform source (iOS/Android/macOS/Windows/Linux)",
        "in_scope": false,
        "rationale": "Objective-C/Swift/Kotlin/Java/C++ application and platform code is compiled into the shipped native binary. Changing it is a separate update domain requiring a new native binary."
      },
      {
        "id": "NB-2",
        "title": "Flutter engine and Dart VM C/C++ changes after release",
        "in_scope": false,
        "rationale": "We fork and modify the engine and VM freely BEFORE a release is cut; the shipped native binary is then fixed. Replacing it post-release is not part of this promise."
      },
      {
        "id": "NB-3",
        "title": "Native plugin ABI changes",
        "in_scope": false,
        "rationale": "A plugin's native side is linked into the shipped binary. Dart-side plugin code is in scope; the native ABI it calls is not."
      },
      {
        "id": "NB-4",
        "title": "New native symbols",
        "in_scope": false,
        "rationale": "A patch may not introduce a native symbol that the shipped binary does not export. Dart code that only reaches existing symbols is in scope."
      },
      {
        "id": "NB-5",
        "title": "Asset and shader transport",
        "in_scope": false,
        "rationale": "Delivering non-Dart payloads is an existing separate mechanism. Dart code changes that merely reference already-shipped assets are in scope."
      },
      {
        "id": "NB-6",
        "title": "Store distribution policy",
        "in_scope": false,
        "rationale": "Whether a given patch is permitted by a platform vendor is a policy question, not an engine capability."
      },
      {
        "id": "NB-7",
        "title": "Backend rollout, targeting and delivery service",
        "in_scope": false,
        "rationale": "Getting a validated patch to a device is the control plane's job and already exists. This program owns whether the patch can be represented and installed correctly once it arrives."
      }
    ],
    "exclusion_classes": [
      {
        "id": "X-SDK-FIXED",
        "title": "Core-library representation with SDK-fixed layout",
        "rationale": "The class ships inside the released SDK and its layout cannot change under a fixed native binary. USER STATE HELD IN SUCH OBJECTS IS NOT EXCLUDED -- it is covered by RS-01, which owns existing heap instances. What is excluded is the class's own shape."
      },
      {
        "id": "X-VM-METADATA",
        "title": "VM code metadata, not observable Dart program state",
        "rationale": "Descriptor and map structures that describe compiled code. They are regenerated with the code they describe and are not addressable as Dart program state, so they carry no independent patch semantics. They are consequences of RS-04, not rows."
      },
      {
        "id": "X-NATIVE-BOUNDARY",
        "title": "FFI and native interop objects",
        "rationale": "These name native memory and native symbols directly. Their patch semantics are governed by the native boundary, not by Dart mutability.",
        "boundary_ref": "NB-4"
      },
      {
        "id": "X-ERROR-OBJECT",
        "title": "VM error and unwind objects",
        "rationale": "These represent a failed execution state rather than a program construct a developer edits. A patch changes the code that produces them; it does not change them."
      }
    ]
  },
