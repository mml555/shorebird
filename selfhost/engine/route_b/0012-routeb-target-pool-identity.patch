+          RouteBReport(path,
+                       "REFUSED (no-release-identity): this snapshot carries "
+                       "no build ID");
+          return;
+        }
+        const std::string running_id(running);
+        ::free(running);
+        RouteBReport(path, "running=" + running_id);
+        if (running_id != container.release_build_id) {
