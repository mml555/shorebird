+static void RouteBSaveOriginalCode(Thread* thread,
+                                   const Function& function,
+                                   const Code& original) {
+  if (route_b_saved_code == nullptr) {
+    route_b_saved_code = new MallocGrowableArray<RouteBSavedCode>();
+  }
