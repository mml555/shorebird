+// SEMANTIC-LINKER-1 G2, EXPERIMENT-ONLY INSTRUMENT. Not part of Route B and
+// not shipped: it answers "in what mode would a call to this function execute
+// RIGHT NOW", which G2 requires as evidence because output alone cannot
+// distinguish an interpreted body from an AOT one that happens to agree.
+//
+// EVERY OUTCOME IS ITS OWN STATE. The fork has already paid for collapsing
+// states once (dart_route_b_trace.h records a counter defaulting to 0 that read
+// as a real mismatch produced by a branch that never ran). "Not found" is not
+// "not interpreted", and "built without dynamic modules" is neither -- so a
+// harness cannot mistake an unresolved name for a negative result.
+//
+//   -1 UNSUPPORTED  built without dart_dynamic_modules
+//    0 NOT_FOUND    the library/class/member did not resolve
+//    1 AOT          resolved, has Code, not interpreted
+//    2 INTERPRETED  resolved, Function::IsInterpreted()
+//    3 NO_CODE      resolved, but neither -- kept distinct rather than folded
+//                   into AOT, because "neither" is exactly what a wrong answer
+//                   would look like
+DEFINE_NATIVE_ENTRY(Internal_functionExecutionMode, 0, 2) {
+#if defined(DART_DYNAMIC_MODULES)
+  GET_NON_NULL_NATIVE_ARGUMENT(String, library_uri, arguments->NativeArgAt(0));
+  GET_NON_NULL_NATIVE_ARGUMENT(String, target_name, arguments->NativeArgAt(1));
+
+  // READ lock, not write: this observes and must not be able to mutate the
+  // thing it is observing. Instrumentation is treated as potentially causal
+  // until shown otherwise, and a writer lock here would be a real difference
+  // between an instrumented run and a plain one.
+  SafepointReadRwLocker ml(thread, thread->isolate_group()->program_lock());
+
+  const auto& target = Function::Handle(
+      zone, ResolvePatchTarget(thread, zone, library_uri, target_name));
+  if (target.IsNull()) {
+    return Smi::New(0);
+  }
+  if (target.IsInterpreted()) {
+    return Smi::New(2);
+  }
+  if (target.HasCode()) {
+    return Smi::New(1);
+  }
+  return Smi::New(3);
+#else
+  return Smi::New(-1);
+#endif  // defined(DART_DYNAMIC_MODULES)
+}
+
