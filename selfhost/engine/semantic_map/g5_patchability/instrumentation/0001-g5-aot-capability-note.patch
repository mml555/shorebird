+// SM1-G5 EVIDENCE INSTRUMENTATION.
+//
+// G5 measured that a release built WITHOUT --patchable_static_calls attaches a
+// replacement, reports "APPLY ok", and then keeps running the old body. So
+// patchability depends on how the RELEASE BINARY was produced, and its absence
+// is a silent bypass. A build transcript is not evidence of that: it records
+// what someone typed, not what the compiler did.
+//
+// This writes the compiler's OWN parsed flag state into the artifact, so the
+// fact can be read back off the exact bytes that will ship. It is versioned so
+// a reader can distinguish "false" from "written by a schema I do not know".
+DECLARE_FLAG(bool, patchable_static_calls);
+
+static constexpr char kShorebirdNoteOwner[] = "Shorebird";
+
+void ElfWriter::GenerateCapabilities() {
+  ASSERT(section_table_->Find(kCapabilitiesNoteName) == nullptr);
+  const char* const payload =
+      FLAG_patchable_static_calls
+          ? "schema_version=1;patchable_static_calls=true"
+          : "schema_version=1;patchable_static_calls=false";
+  const intptr_t description_length = strlen(payload) + 1;
+  ZoneWriteStream stream(
+      zone(), sizeof(elf::Note) + sizeof(kShorebirdNoteOwner) +
+                  description_length);
+  stream.WriteFixed<decltype(elf::Note::name_size)>(
+      sizeof(kShorebirdNoteOwner));
+  stream.WriteFixed<decltype(elf::Note::description_size)>(description_length);
+  stream.WriteFixed<decltype(elf::Note::type)>(
+      static_cast<elf::NoteType>(1));
+  stream.WriteBytes(kShorebirdNoteOwner, sizeof(kShorebirdNoteOwner));
+  stream.WriteBytes(reinterpret_cast<const uint8_t*>(payload),
+                    description_length);
+  auto* const container = new (zone_) NoteSection();
+  container->AddPortion(stream.buffer(), stream.bytes_written());
+  section_table_->Add(container, kCapabilitiesNoteName);
+}
