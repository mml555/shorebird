 static constexpr char kShorebirdNoteOwner[] = "Shorebird";
 
+// SM1-G5 route 2 registry.
+//
+// THREE THINGS THIS HAS TO GET RIGHT, because ABSENCE from the relation is what
+// the map would treat as "not inlined":
+//
+// 1. RACE-FREE. The first version lazily created the mutex OUTSIDE any
+//    synchronization, so two compiler threads could each construct their own
+//    mutex and then mutate the shared registry under different locks. A dropped
+//    record reads as "not inlined", which is the false-safe condition this gate
+//    exists to prevent. The mutex is now a function-local static, whose
+//    initialization C++11 guarantees to be thread-safe and which lives for the
+//    process.
+//
+// 2. DETERMINISTIC. Entries are sorted and de-duplicated at emission, so
+//    compiler scheduling cannot change the artifact bytes.
+//
+// 3. A ZoneGrowableArray global segfaulted here: a zone does not outlive one
+//    compilation, so the pointer dangled by the time the ELF writer ran.
+//    Storage is malloc-backed.
+static Mutex* shorebird_mutex() {
+  static Mutex m;
+  return &m;
+}
+static MallocGrowableArray<const char*>* shorebird_inlining = nullptr;
+
+static const char* shorebird_key(const char* lib, const char* owner,
+                                 const char* kind, const char* name) {
+  return OS::SCreate(nullptr, "%s#%s#%s#%s", lib, owner, kind, name);
+}
+
+void ShorebirdRecordInlined(const char* inlinee_lib, const char* inlinee_owner,
+                            const char* inlinee_kind, const char* inlinee_name,
+                            const char* caller_lib, const char* caller_owner,
+                            const char* caller_kind, const char* caller_name) {
+  MutexLocker ml(shorebird_mutex());
+  if (shorebird_inlining == nullptr) {
+    shorebird_inlining = new MallocGrowableArray<const char*>();
+  }
+  shorebird_inlining->Add(OS::SCreate(
+      nullptr, "%s\t%s",
+      shorebird_key(inlinee_lib, inlinee_owner, inlinee_kind, inlinee_name),
+      shorebird_key(caller_lib, caller_owner, caller_kind, caller_name)));
+}
+
+static int shorebird_cmp(const char* const* a, const char* const* b) {
+  return strcmp(*a, *b);
+}
