+                         const char** owner, const char** kind,
+                         const char** name) {
+        *kind = Function::KindToCString(fn.kind());
+        *name = fn.name() == String::null()
+                    ? "<null>"
+                    : String::Handle(fn.name()).ToCString();
+        const Object& raw_owner = Object::Handle(fn.RawOwner());
