+// SM1-G5 EVIDENCE INSTRUMENTATION.
+//
+// G5 measured that a release built WITHOUT --patchable_static_calls attaches a
+// replacement, reports "APPLY ok", and then keeps running the old body. So
+// patchability depends on how the RELEASE BINARY was produced, and its absence
+// is a silent bypass. A build transcript is not evidence of that: it records
+// what someone typed, not what the compiler did.
+//
+// This writes the compiler's OWN parsed flag state into the artifact, so the
+// fact can be read back off the exact bytes that will ship. It is versioned so
+// a reader can distinguish "false" from "written by a schema I do not know".
+DECLARE_FLAG(bool, patchable_static_calls);
+
+static constexpr char kShorebirdNoteOwner[] = "Shorebird";
+
+// A ZoneGrowableArray here segfaulted: it allocates in the CURRENT zone, which
+// does not outlive a single compilation, so the global pointer dangled by the
+// time the ELF writer read it. Malloc-backed storage persists for the process.
+//
+// SM1-G5 route 2 registry. Compilation can be concurrent, so the set is
+// mutex-guarded; an unguarded container would drop entries and a dropped entry
+// is a declaration silently reported as not-inlined.
+static Mutex* shorebird_inlining_mutex = nullptr;
+static MallocGrowableArray<const char*>* shorebird_inlining = nullptr;
 
+void ShorebirdRecordInlined(const char* inlinee, const char* caller) {
+  if (shorebird_inlining_mutex == nullptr) {
+    shorebird_inlining_mutex = new Mutex();
+  }
+  MutexLocker ml(shorebird_inlining_mutex);
+  if (shorebird_inlining == nullptr) {
+    shorebird_inlining = new MallocGrowableArray<const char*>();
+  }
+  shorebird_inlining->Add(Utils::StrDup(inlinee));
+  shorebird_inlining->Add(Utils::StrDup(caller));
+}
+
+void ElfWriter::GenerateCapabilities() {
+  ASSERT(section_table_->Find(kCapabilitiesNoteName) == nullptr);
+  const char* const payload =
+      FLAG_patchable_static_calls
+          ? "schema_version=1;patchable_static_calls=true"
+          : "schema_version=1;patchable_static_calls=false";
+  const intptr_t description_length = strlen(payload) + 1;
+  ZoneWriteStream stream(
+      zone(), sizeof(elf::Note) + sizeof(kShorebirdNoteOwner) +
+                  description_length);
+  stream.WriteFixed<decltype(elf::Note::name_size)>(
+      sizeof(kShorebirdNoteOwner));
+  stream.WriteFixed<decltype(elf::Note::description_size)>(description_length);
+  stream.WriteFixed<decltype(elf::Note::type)>(
+      static_cast<elf::NoteType>(1));
+  stream.WriteBytes(kShorebirdNoteOwner, sizeof(kShorebirdNoteOwner));
+  stream.WriteBytes(reinterpret_cast<const uint8_t*>(payload),
+                    description_length);
+  auto* const container = new (zone_) NoteSection();
+  container->AddPortion(stream.buffer(), stream.bytes_written());
+  section_table_->Add(container, kCapabilitiesNoteName);
+}
+
+// One line per inlining decision: "inlinee<TAB>caller". A declaration that
+// appears in the FIRST column has at least one copy of its body somewhere else
+// in this release, so a patch to it cannot reach that copy.
+void ElfWriter::GenerateInliningRelation() {
+  ASSERT(section_table_->Find(kInliningNoteName) == nullptr);
+  TextBuffer buf(1024);
+  buf.AddString("schema_version=1\n");
+  if (shorebird_inlining != nullptr) {
+    MutexLocker ml(shorebird_inlining_mutex);
+    for (intptr_t i = 0; i + 1 < shorebird_inlining->length(); i += 2) {
+      buf.Printf("%s\t%s\n", (*shorebird_inlining)[i],
+                 (*shorebird_inlining)[i + 1]);
+    }
+  }
+  const char* payload = buf.buffer();
+  const intptr_t description_length = strlen(payload) + 1;
+  ZoneWriteStream stream(
+      zone(), sizeof(elf::Note) + sizeof(kShorebirdNoteOwner) +
+                  description_length);
+  stream.WriteFixed<decltype(elf::Note::name_size)>(
+      sizeof(kShorebirdNoteOwner));
+  stream.WriteFixed<decltype(elf::Note::description_size)>(description_length);
+  stream.WriteFixed<decltype(elf::Note::type)>(static_cast<elf::NoteType>(2));
+  stream.WriteBytes(kShorebirdNoteOwner, sizeof(kShorebirdNoteOwner));
+  stream.WriteBytes(reinterpret_cast<const uint8_t*>(payload),
+                    description_length);
+  auto* const container = new (zone_) NoteSection();
+  container->AddPortion(stream.buffer(), stream.bytes_written());
+  section_table_->Add(container, kInliningNoteName);
+}
