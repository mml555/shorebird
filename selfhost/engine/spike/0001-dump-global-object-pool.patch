+// SELFHOST spike (Spike A): the structured pool dump behind
+// --dump_global_object_pool_to. Walks the FINALIZED pool (same site as
+// FLAG_disassemble's DebugPrint) so it sees exactly what the snapshot ships.
+[[maybe_unused]] void SelfhostDumpGlobalObjectPoolTo(const ObjectPool& pool,
+                                                     const char* filename) {
+  auto file_open = Dart::file_open_callback();
+  auto file_write = Dart::file_write_callback();
+  auto file_close = Dart::file_close_callback();
+  if ((file_open == nullptr) || (file_write == nullptr) ||
+      (file_close == nullptr)) {
+    OS::PrintErr("warning: Could not access file callbacks.\n");
+    return;
+  }
+  void* file = file_open(filename, /*write=*/true);
+  if (file == nullptr) {
+    OS::PrintErr("warning: Failed to write pool dump: %s\n", filename);
+    return;
+  }
+  Thread* thread = Thread::Current();
+  Zone* zone = thread->zone();
+  Object& obj = Object::Handle(zone);
+  Array& arr = Array::Handle(zone);
+  Object& elem = Object::Handle(zone);
+  Function& fn = Function::Handle(zone);
+  Closure& closure = Closure::Handle(zone);
+  for (intptr_t i = 0; i < pool.Length(); i++) {
+    TextBuffer line(256);
+    line.Printf("{\"i\":%" Pd ",\"type\":%d,\"patchable\":%d", i,
+                static_cast<int>(pool.TypeAt(i)),
+                static_cast<int>(pool.PatchableAt(i)));
+    if (pool.TypeAt(i) == ObjectPool::EntryType::kTaggedObject) {
+      obj = pool.ObjectAt(i);
+      line.Printf(",\"cid\":%" Pd, static_cast<intptr_t>(obj.GetClassId()));
+      line.AddString(",\"s\":\"");
+      SelfhostJsonEscapeInto(&line, obj.ToCString());
+      line.AddString("\"");
+      if (obj.IsArray() || (obj.GetClassId() == kImmutableArrayCid)) {
+        arr ^= obj.ptr();
+        line.Printf(",\"len\":%" Pd ",\"elems\":[", arr.Length());
+        const intptr_t n = arr.Length() < 16 ? arr.Length() : 16;
+        for (intptr_t j = 0; j < n; j++) {
+          elem = arr.At(j);
+          if (j > 0) line.AddString(",");
+          line.AddString("\"");
+          SelfhostJsonEscapeInto(&line, elem.ToCString());
+          line.AddString("\"");
+        }
+        line.AddString("]");
+      } else if (obj.IsFunction()) {
+        fn ^= obj.ptr();
+        line.AddString(",\"fq\":\"");
+        SelfhostJsonEscapeInto(&line, fn.ToLibNamePrefixedQualifiedCString());
+        line.Printf("\",\"tok\":%d",
+                    static_cast<int>(fn.token_pos().Serialize()));
+      } else if (obj.IsClosure()) {
+        closure ^= obj.ptr();
+        fn = closure.function();
+        line.AddString(",\"fq\":\"");
+        SelfhostJsonEscapeInto(&line, fn.ToLibNamePrefixedQualifiedCString());
+        line.Printf("\",\"tok\":%d",
+                    static_cast<int>(fn.token_pos().Serialize()));
+      }
+    } else {
+      line.Printf(",\"imm\":%" Pd, static_cast<intptr_t>(pool.RawValueAt(i)));
+    }
+    line.AddString("}\n");
+    file_write(line.buffer(), line.length(), file);
+  }
+  file_close(file);
+}
