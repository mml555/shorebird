+// SELFHOST spike (Spike A): JSON-escape into a text buffer.
+[[maybe_unused]] void SelfhostJsonEscapeInto(BaseTextBuffer* buf,
+                                             const char* s) {
+  for (const char* p = s; *p != '\0'; p++) {
+    const uint8_t c = static_cast<uint8_t>(*p);
+    switch (c) {
+      case '"':
+        buf->AddString("\\\"");
+        break;
+      case '\\':
+        buf->AddString("\\\\");
+        break;
+      case '\n':
+        buf->AddString("\\n");
+        break;
+      case '\r':
+        buf->AddString("\\r");
+        break;
+      case '\t':
+        buf->AddString("\\t");
+        break;
+      default:
+        if (c < 0x20 || c >= 0x7f) {
+          buf->Printf("\\u%04x", c);
+        } else {
+          buf->Printf("%c", c);
+        }
+    }
+  }
+}
