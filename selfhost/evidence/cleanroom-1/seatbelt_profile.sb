(version 1)
(allow default)
(deny file-read* (subpath "/Volumes/build"))
(deny file-read* (subpath "/Users/mendell/shorebird"))
(deny file-read* (subpath "/Users/mendell/.shorebird"))
(deny file-read* (subpath "/Users/mendell/.pub-cache"))
(deny file-read* (subpath "/Users/mendell/.gradle"))
(deny file-read* (subpath "/Users/mendell/Library/Caches/flutter"))
(allow file-read-metadata (literal "/Volumes/build/cleanroom1"))
(allow file-read-metadata (literal "/Volumes/build"))
(allow file-read-metadata (literal "/Volumes"))
(allow file-read* (subpath "/Volumes/build/cleanroom1"))
