(version 1)
(allow default)
(deny file-read* (subpath "/Volumes/build/route-b"))
(deny file-read* (subpath "/Users/mendell/shorebird"))
(deny file-read* (subpath "/Users/mendell/.shorebird"))
(deny file-read* (subpath "/Users/mendell/.pub-cache"))
(deny file-read* (subpath "/Users/mendell/.gradle"))
(allow file-read-metadata (literal "/Volumes/build/cleanroom2"))
(allow file-read-metadata (literal "/Volumes/build"))
(allow file-read-metadata (literal "/Volumes"))
(allow file-read* (subpath "/Volumes/build/cleanroom2"))
