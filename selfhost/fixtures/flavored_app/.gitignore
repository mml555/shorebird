# Fixture-local, and deliberately not an entry in the repo-root .gitignore the
# way airgap_app's generated dirs are (root .gitignore:37-47). Keeping it here
# makes the fixture self-contained: the committed/generated split is visible in
# the directory it governs, and a future fixture can be added without editing a
# file three levels up.
#
# THE SPLIT. Committed: pubspec.yaml, lib/, assets/, shorebird.yaml.template,
# ios_overlay/, android_overlay/, README.md. Generated by
# selfhost/scripts/prepare_flavored_fixture.sh and reproducible from those:
# ios/, android/, shorebird.yaml, .generated/.

# `flutter create` output. The OVERLAY is committed; the tree it is applied to
# is not, because it belongs to the pinned Flutter's generator and is gated by a
# recorded sha rather than by review.
/ios/
/android/

# Written by --activate from .generated/shorebird.<arm>.yaml. Never committed:
# app_id is server-generated (POST /api/v1/apps ignores a requested id) and
# base_url is a per-run LAN address.
/shorebird.yaml
/.generated/

/build/
/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.DS_Store

# `flutter create` also emits these, and none of them belong to the fixture:
# a widget test that references flutter_lints (absent from pubspec by design —
# see the no-plugins reasoning there), an analysis_options.yaml that includes
# that same missing package, and IDE scaffolding. Left generated so
# `dart analyze` on the COMMITTED sources is clean; prepare_flavored_fixture.sh
# removes them after create.
/test/
/analysis_options.yaml
/.idea/
/.metadata
/flavored_probe.iml
