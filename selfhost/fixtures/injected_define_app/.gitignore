# Fixture-local, mirroring flavored_app's split so the committed/generated
# boundary is visible in the directory it governs.
#
# THE SPLIT. Committed: pubspec.yaml, lib/, shorebird.yaml.template, README.md.
# Generated by `flutter create --platforms=ios .` plus a shorebird.yaml written
# from the template: ios/, android/, shorebird.yaml.

# `flutter create` output. No overlay is committed for this fixture because it
# needs no flavors and no scheme surgery — the stock tree is correct, which is
# the one way this fixture is simpler than flavored_app.
/ios/
/android/

# app_id is server-generated and base_url is a per-run LAN address, so a
# committed shorebird.yaml would be wrong on any other machine.
/shorebird.yaml

/build/
/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.DS_Store

# `flutter create` also emits these and none belong to the fixture: a widget
# test referencing flutter_lints (absent from pubspec by design), an
# analysis_options.yaml that includes that same missing package, and IDE
# scaffolding. Left generated so `dart analyze` on the COMMITTED sources is
# clean.
/test/
/analysis_options.yaml
/.idea/
/.metadata
/injected_define_probe.iml
