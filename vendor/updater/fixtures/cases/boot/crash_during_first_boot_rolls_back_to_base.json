        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    },
    "storage/pointers.json": {
      "json": {
        "next_boot_patch": 1,
        "last_booted_patch": null,
        "currently_booting_patch": 1,
        "boot_started_at": 1700000000,
        "boot_attempt_count": 2,
        "last_boot_attempt_patch": 1
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 5
      }
    },
    "storage/patches/1/dlc.vmcode": {
      "text": "hello"
    }
  },
  "steps": [
