{
  "description": "A death after launch_resumed (the root isolate launching), before the outcome, is an ambiguous boot like any death before success: the first retries the patch (the pause before the resume did not count as an attempt), the second reaches the threshold and marks the patch Bad on the next launch, which boots the release.",
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    },
    "storage/pointers.json": {
      "json": {
        "next_boot_patch": 1,
        "last_booted_patch": null,
        "currently_booting_patch": null,
        "boot_started_at": null
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 5
      }
    },
    "storage/patches/1/dlc.vmcode": {
      "text": "hello"
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "report_launch_start"
    },
    {
      "call": "report_launch_paused"
    },
    {
      "call": "report_launch_resumed",
      "expect_files": {
        "storage/pointers.json": {
          "json": {
            "next_boot_patch": 1,
            "last_booted_patch": null,
            "currently_booting_patch": 1,
            "boot_started_at": "<number>",
            "boot_attempt_count": 1,
            "last_boot_attempt_patch": 1
          }
        }
      }
    },
    {
      "call": "restart"
    },
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "next_boot_patch_number",
      "expect": 1
    },
    {
      "call": "report_launch_start"
    },
    {
      "call": "report_launch_paused"
    },
    {
      "call": "report_launch_resumed"
    },
    {
      "call": "restart"
    },
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "next_boot_patch_number",
      "expect": 0,
      "expect_files": {
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Bad",
            "reason": "BootCrash",
            "hash": null,
            "signature": null,
            "size": 5
          }
        },
        "storage/patches/1/dlc.vmcode": {
          "absent": true
        }
      }
    }
  ]
}
